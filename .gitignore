# 依赖
node_modules/

# 构建产物
dist/
.astro/

# 线上数据导出（由 jyuanblog-worker/export-remote-data.mjs 生成，本地构建用）
.build-api/

# 环境变量（含本地 API 地址）
# .env.production 里是构建期 API 基址，刻意留在本地：需要入库时 git add -f
.env
.env.local
.env.production
.env.*.local

# wrangler 本地状态（pages dev 的临时物与本地 D1，4.5 MB，绝不该进版本库）
.wrangler/

# 品牌字体源文件（24 MB/个，构建输入；产物只是几十 KB 的子集）。
# 由 npm run fonts:fetch 按固定版本 + sha256 拉取。OFL.txt 反过来要入库。
src/assets/fonts/*.ttf
src/assets/fonts/*.otf

# 日志
*.log
