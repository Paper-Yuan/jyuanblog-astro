---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCategories, getAllArticles } from '@/lib/api';

const [categories, articles] = await Promise.all([getCategories(), getAllArticles()]);

// 统计每个分类的实际文章数（后端也给，但本地算更稳）
const countOf = new Map<number, number>();
for (const a of articles) {
  if (a.category) countOf.set(a.category.id, (countOf.get(a.category.id) ?? 0) + 1);
}
---

<BaseLayout title="分类">
  <header class="head">
    <h1 class="type-headline-lg">分类</h1>
    <p class="muted type-body-md">共 {categories.length} 个分类</p>
  </header>

  {
    categories.length === 0 ? (
      <p class="empty">还没有分类。</p>
    ) : (
      <div class="grid">
        {categories.map((c) => (
          <a href={`/categories/${c.slug}`} class="m3-card m3-card--interactive cat">
            <span class="name type-title-lg">{c.name}</span>
            {c.description && <span class="desc type-body-sm">{c.description}</span>}
            <span class="n type-label-md">{countOf.get(c.id) ?? 0} 篇</span>
          </a>
        ))}
      </div>
    )
  }
</BaseLayout>

<style>
  .head {
    margin-bottom: var(--m3e-space-6);
  }

  .muted {
    margin-top: var(--m3e-space-2);
    color: var(--on-surface-variant);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--m3e-space-4);
  }

  .cat {
    display: flex;
    flex-direction: column;
    gap: var(--m3e-space-1);
    color: var(--on-surface);
  }

  .cat:hover {
    text-decoration: none;
  }

  .desc,
  .n {
    color: var(--on-surface-variant);
  }

  .empty {
    padding: var(--m3e-space-8) 0;
    text-align: center;
    color: var(--on-surface-variant);
  }
</style>
