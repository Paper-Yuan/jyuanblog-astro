---
/**
 * 首页。
 *
 * 首屏刻意**不做**"居中大标题 + 两个按钮"那种模板脸：
 *   · 左栏是名号（站名走展示字体 + 一条织出来的纬线 + 三个入口）
 *   · 右栏是「机杼·近一年」—— 用最近 12 个月的发布量画的节奏条，
 *     数据来自构建期的文章列表，所以它既是母题也是信息，
 *     不是贴一张装饰图。
 * 两栏在 900px 以下叠成一列，节奏条挪到名号下方。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import Icon from '@/components/Icon.astro';
import WidgetSidebar from '@/components/WidgetSidebar.astro';
import { getArticles, getPopular } from '@/lib/api';
import { SITE } from '@/config/site';

const [{ list: articles }, popular, all] = await Promise.all([
  getArticles({ page: 1, pageSize: SITE.pageSize }),
  getPopular(5).catch(() => []),
  // 节奏条要跨月聚合，首页那 8 条不够看。取全量（构建期请求已带备忘录，
  // 与侧栏 StatsWidget 命中同一条缓存，不多花一次请求）
  getArticles({ page: 1, pageSize: 100 }).then((d) => d.list).catch(() => []),
]);

const [feature, ...rest] = articles;

/**
 * 最近 12 个月的发布量。
 *
 * ★ 时区：文章的 createdAt 是 UTC 串，直接 getMonth() 会按运行环境时区解释，
 *   构建机与访客看到的月份可能差一格。统一过 SITE.timeZone（与发布日历同一做法）。
 */
function monthKey(iso: string) {
  const [y, m] = new Intl.DateTimeFormat('en-CA', {
    timeZone: SITE.timeZone,
    year: 'numeric',
    month: '2-digit',
  })
    .format(new Date(iso))
    .split('-');
  return `${y}-${m}`;
}

const now = new Date();
const months = Array.from({ length: 12 }, (_, i) => {
  const d = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() - (11 - i), 1));
  const key = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
  return { key, label: String(Number(d.getUTCMonth() + 1)), n: 0, current: i === 11 };
});
{
  const idx = new Map(months.map((m, i) => [m.key, i]));
  for (const a of all) {
    const i = idx.get(monthKey(a.createdAt));
    if (i !== undefined) months[i].n += 1;
  }
}
const peak = Math.max(1, ...months.map((m) => m.n));
const activeMonths = months.filter((m) => m.n > 0).length;
const publishedLast12 = months.reduce((s, m) => s + m.n, 0);

/**
 * 布的算法：一趟纬 = 一篇文章，等厚。
 *
 * 早先是 `n / peak * 100%` 的归一化柱状图 —— 于是"1 篇"和"3 篇"的高度关系
 * 完全取决于那个月碰巧有几篇，读者得回头数轴才知道布有多厚；而空月份留了个
 * 3% 的小胖墩，看着像"这几个月织了一点点"，是假信息。
 * 现在布厚按峰值月倒推（峰值刚好顶到可用高度），于是布边数就是篇数：
 * 一格三条纬 = 那个月发了三篇，不需要坐标轴。
 */
const WEFT_GAP = 2;
/* 可织高度 = 格子 104 − 篇数行 13 − 月份行 16 − 两道间隙 4。
   数字对不上的话布会顶出格子，被板子的 overflow:hidden 削掉一截。 */
const CLOTH_ROOM = 72;
const WEFT_BAND = Math.max(
  3,
  Math.min(16, Math.floor((CLOTH_ROOM - (peak - 1) * WEFT_GAP) / peak))
);
/* 上限兜一道：极密的年份（一年几十篇）带子会薄到读不出，宁可退回比例柱，
   也不要让布顶破格子 —— 等厚这个承诺在正常密度下成立就够了。 */
const clothH = (n: number) =>
  n > 0 ? Math.min(n * WEFT_BAND + (n - 1) * WEFT_GAP, CLOTH_ROOM) : 0;

---

<BaseLayout>
  <!-- ===================== 首屏：名号 + 机杼 ===================== -->
  <section class="masthead">
    <div class="mast-copy">
      <p class="kicker type-label-lg">
        <span class="m3-accent-bar" aria-hidden="true"></span>
        机杼 · 机巧 · 百变机关
      </p>

      <h1 class="wordmark">{SITE.title}</h1>
      <!-- 纬线：从左抽到右的入场动画把视线带向下方的入口区。
           默认状态就是满宽可见的，动画只负责"演进来"（三条铁律之一） -->
      <span class="thread-rule thread-rule--animated" aria-hidden="true"></span>

      <p class="sub type-body-lg">{SITE.subtitle}</p>

      <div class="mast-actions">
        <a href="/blog" class="m3-button m3-button--filled">浏览全部文章</a>
        <a href="/search" class="m3-button m3-button--outlined">
          <Icon name="search" size={16} /> 搜索
        </a>
        <a href="/timeline" class="m3-button m3-button--text">
          <Icon name="flag" size={16} /> 时间线
        </a>
      </div>
    </div>

    <!-- 机杼·近一年：12 根经线位，发布过的月份压上纬线（一趟纬 = 一篇） -->
    <figure class="loom m3-reveal">
      <div
        class="loom-plate pulse"
        role="img"
        aria-label={`最近 12 个月共发布 ${publishedLast12} 篇，一趟纬线代表一篇；其中 ${activeMonths} 个月有落笔，最密的月份 ${peak} 篇`}
      >
        <span class="loom-kite" aria-hidden="true"></span>
        <div class="bars">
          {
            months.map((m, i) => (
              <div
                class={`bar${m.n ? ' has' : ''}${m.current ? ' now' : ''}`}
                data-year-start={m.label === '1' && i > 0 ? '' : undefined}
                style={`--h:${clothH(m.n)}px; --weft-th:${WEFT_BAND}px; --weft-period:${WEFT_BAND + WEFT_GAP}px; --i:${i}`}
                title={`${m.key} · ${m.n} 篇`}
              >
                <span class="bar-n">{m.n || ''}</span>
                <span class="bar-fill" aria-hidden="true"></span>
                <span class="bar-lab type-label-sm">{m.label}</span>
              </div>
            ))
          }
        </div>
      </div>
      <figcaption class="loom-cap type-body-sm">
        <span>机杼 · 近一年</span>
        <span class="loom-meta">
          一趟纬 = 一篇 · {activeMonths} 个月有落笔 · 最密 {peak} 篇
        </span>
      </figcaption>
    </figure>
  </section>

  <!--
    主区 + 侧栏。
    栅格只在 >= 1280px 摆成两列 —— 断点必须与「主列不变量」反推一致：
    >= 1280 时版心放宽到 1280，左边先给常驻悬浮栏的图标条 64 + 24，
    剩下的 1144 正好是 840 主列 + 24 间隙 + 280 部件列（variables.css 的反推）。
    若更早摆两列（比如 1200px），主列会被压到 760，跌破 840 的下界 ——
    加了侧栏反而更难看，且不会报错。
  -->
  <div class="page-grid">
    <div class="main-col">
      <!-- 最新文章 -->
      <section class="section">
        <header class="section-head">
          <h2 class="type-headline-sm">
            <span class="m3-accent-bar" aria-hidden="true"></span>最新文章
          </h2>
          <a href="/blog" class="more type-label-lg">全部 →</a>
        </header>

        {
          articles.length === 0 ? (
            <p class="empty">还没有已发布的文章。</p>
          ) : (
            <div class="grid m3-stagger">
              {feature && <ArticleCard article={feature} feature />}
              {rest.map((a) => (
                <ArticleCard article={a} />
              ))}
            </div>
          )
        }
      </section>

      <!-- 热门：分类与标签已搬去常驻悬浮栏，这里不再重复一份 -->
      {
        popular.length > 0 && (
          <section class="section">
            <header class="section-head">
              <h2 class="type-headline-sm">
                <span class="m3-accent-bar" aria-hidden="true"></span>热门文章
              </h2>
              <span class="more type-body-sm text-muted">按阅读量</span>
            </header>
            <div class="m3-card panel">
              <ol class="popular">
                {popular.map((a, i) => (
                  <li>
                    <span class="rank">{i + 1}</span>
                    <a href={`/blog/${a.slug}`}>{a.title}</a>
                    <span class="muted type-body-sm">{a.viewCount} 阅读</span>
                  </li>
                ))}
              </ol>
            </div>
          </section>
        )
      }
    </div>

    <WidgetSidebar articles={articles} />
  </div>
</BaseLayout>

<style>
  /* ---- 首屏 ---- */
  .masthead {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--m3e-space-8);
    align-items: center;
    padding: var(--m3e-space-8) 0 var(--m3e-space-5);
  }

  @media (min-width: 900px) {
    .masthead {
      /* 名号占主文区，机杼板固定宽度：正文列宽与它无关，不会被它挤 */
      grid-template-columns: minmax(0, 1fr) minmax(240px, 360px);
    }
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: var(--m3e-space-3);
    margin: 0;
    color: var(--on-surface-variant);
    letter-spacing: 0.08em;
  }

  /*
   * 站名。刻意**不做**渐变字：
   * 粉→紫的渐变标题是"AI 做的页面"最典型的指纹之一，
   * 而且渐变压在小字号上会糊。这里让品牌字自己说话（霞鹜文楷子集），
   * 颜色用 on-surface，对比度 12:1 以上。
   */
  .wordmark {
    margin: var(--m3e-space-4) 0 0;
    font-family: var(--m3e-font-display);
    font-size: var(--m3e-display-lg-size);
    line-height: var(--m3e-display-lg-line);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--on-surface);
  }

  .thread-rule {
    margin-top: var(--m3e-space-4);
  }

  .sub {
    margin-top: var(--m3e-space-4);
    color: var(--on-surface-variant);
  }

  .mast-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--m3e-space-3);
    margin-top: var(--m3e-space-6);
  }

  /* ---- 机杼·近一年 ---- */
  .loom {
    margin: 0;
  }

  .loom-plate {
    padding: var(--m3e-space-4) var(--m3e-space-3) var(--m3e-space-2);
  }

  .pulse {
    position: relative;
    /* 让经线板露出一点"未织满"的空档：高度固定，条子在其中自下而上 */
    min-height: 132px;
  }

  .bars {
    --loom-lab-h: 16px; /* 月份刻度那一行的高度：布口线与各列经线都从它倒推 */
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: end;
    gap: 3px;
    height: 104px;
  }

  /* 布口（fell）：织到哪儿，线就在哪儿。整排格子坐在同一条线上，
     否则十二根柱子与板子底边之间那条空白会让布看着是浮着的。 */
  .bars::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--loom-lab-h) + 2px);
    height: 1px;
    background: var(--loom-weft);
    opacity: 0.6;
  }

  .bar {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    height: 100%;
    gap: 2px;
  }

  /* 空档 = 上了机还没织的经线：一根居中的竖线，向上渐隐。
     早先这里是一根 3% 高的小胖墩，读起来像"这几个月织了一点点"—— 假信息。 */
  .bar::before {
    content: '';
    position: absolute;
    left: 50%;
    width: 1px;
    margin-left: -0.5px;
    bottom: calc(var(--loom-lab-h) + 2px);
    height: calc(100% - var(--loom-lab-h) - 4px);
    background: linear-gradient(180deg, transparent 18%, var(--loom-warp) 78%);
    opacity: 0.7;
  }

  /* 织上的地方经线让给纬线，只从带缝里透一点出来 */
  .bar.has::before {
    opacity: 0.28;
  }

  /* 跨年的那一格：经线提成"分经"。没有它，12 个数字读不出这是跨了两个年头 */
  .bar[data-year-start]::after {
    content: '';
    position: absolute;
    left: -2px;
    top: 4px;
    bottom: calc(var(--loom-lab-h) + 2px);
    width: 1px;
    background: var(--outline);
    opacity: 0.75;
  }

  .bar-fill {
    --weft-band: var(--surface-container-highest);
    width: 100%;
    height: var(--h, 0px);
    border-radius: 2px 2px 0 0;
    /* 一趟纬一条带，等厚 —— 布边数就是篇数，不需要坐标轴。
       周期 = 带厚 + 2px 间隙，所以最上面那趟不会被裁成半截（布边数才等于篇数）。
       带间那 2px 让底下的经线透出来：那几道透视才是"织出来的"而不是"涂上去的"。 */
    background-image: repeating-linear-gradient(
      0deg,
      var(--weft-band) 0 var(--weft-th, 8px),
      transparent var(--weft-th, 8px) var(--weft-period, 10px)
    );
    transform-origin: bottom;
    transition: height var(--m3e-duration-medium2) var(--m3e-easing-emphasized);
  }

  /* 有发布的月份才染主题色 —— 空档保持容器色，一眼能看出"这几个月没写" */
  .bar.has .bar-fill {
    --weft-band: var(--primary-container);
  }

  .bar.now .bar-fill {
    --weft-band: var(--primary);
  }

  .bar-n {
    font-size: var(--m3e-label-sm-size);
    font-variant-numeric: tabular-nums;
    color: var(--on-surface-variant);
    min-height: 1em;
  }

  /* 篇数跟着布染色，读者才不必在"数字"和"那一格"之间来回找 */
  .bar.has .bar-n {
    color: var(--primary);
    font-weight: 600;
  }

  .bar-lab {
    height: var(--loom-lab-h);
    display: grid;
    place-items: center;
    color: var(--on-surface-variant);
    font-variant-numeric: tabular-nums;
    opacity: 0.75;
  }

  /* 当月：只把刻度点名，不再给整列刷色 —— 板子上已经有纸鸢在动，
     第二个动效位就多余了（摘一件首饰再出门）。 */
  .bar.now .bar-lab {
    color: var(--primary);
    opacity: 1;
    font-weight: 600;
  }

  /* 入场：布从布口往上织出来，一格比一格晚 40ms（布是一格一格织的，
     不是整排同时长出来的）。默认状态就是满高的 —— 动画只负责"演进来"，
     系统要求减少动效或手动关掉时，布照常在那儿。 */
  @media (prefers-reduced-motion: no-preference) {
    :root:not(.motion-reduced) .bar-fill {
      animation-name: m3-weft-shuttle;
      animation-duration: var(--m3e-duration-medium4);
      animation-timing-function: var(--m3e-easing-emphasized-decelerate);
      animation-fill-mode: both;
      animation-delay: calc(var(--i, 0) * 40ms);
    }
  }

  .loom-cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--m3e-space-2) var(--m3e-space-3);
    margin-top: var(--m3e-space-3);
    color: var(--on-surface-variant);
  }

  .loom-cap > span:first-child {
    font-family: var(--m3e-font-display);
    font-weight: 500;
    color: var(--on-surface);
  }

  .loom-meta {
    text-align: right;
  }

  /*
   * 窄屏（约两栏以内）：机杼板只有一格宽，12 根条子摊下来每根 ~27px，
   * 塞不进"10月"三个字，篇数也只会挤成一团 —— 所以：
   *   · 月份每三格留一格（4 个刻度足够交代"这是十二个月"）
   *   · 条子上的篇数收掉（title 与 aria-label 里都有，读屏和鼠标都拿得到）
   *   · 副文案换行后回到左对齐，不再与主标题抢同一行的两端
   */
  @media (max-width: 560px) {
    .bar-lab {
      visibility: hidden;
    }

    .bar:nth-child(3n + 1) .bar-lab {
      visibility: visible;
    }

    .bar-n {
      display: none;
    }

    .bars {
      height: 92px;
      gap: 2px;
    }

    .loom-meta {
      text-align: left;
    }
  }

  /* ---- 主区 + 侧栏 ---- */
  .page-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--m3e-space-6);
    margin-top: var(--m3e-space-5);
  }

  /*
   * 1280 而不是 1200：常驻悬浮栏在 >= 768px 就要占掉栅格左边的 64 + 24，
   * 1200 那一档摆两列会把主列压到 760（跌破 840 下界），
   * 且 1200–1279 的版心本来就没加宽。反推见 variables.css。
   */
  @media (min-width: 1280px) {
    .page-grid {
      grid-template-columns: minmax(0, 1fr) 280px;
    }
  }

  .main-col {
    min-width: 0;
  }

  .section {
    margin-top: var(--m3e-space-8);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--m3e-space-4);
    margin-bottom: var(--m3e-space-5);
  }

  .section-head h2 {
    display: flex;
    align-items: center;
    gap: var(--m3e-space-3);
  }

  .more {
    color: var(--primary);
    white-space: nowrap;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--m3e-space-5);
  }

  :global(:root[data-layout='list']) .grid {
    grid-template-columns: 1fr;
  }

  /* 首卡通栏：宽屏上第一张卡横贯两列，制造"错落"而不是等大方阵 */
  @media (min-width: 1200px) {
    .grid > :global(.card):first-child {
      grid-column: 1 / -1;
    }
  }

  /* 与 ArticleCard 保持同一种容器语言：面板底色与页底仅差 1.05:1，需描边才有边界 */
  .panel {
    border: 1px solid var(--outline-variant);
  }

  .popular {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--m3e-space-1) var(--m3e-space-6);
  }

  .popular li {
    display: flex;
    align-items: center;
    gap: var(--m3e-space-3);
    padding: var(--m3e-space-2) 0;
  }

  .rank {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border-radius: var(--shape-corner-full);
    background: var(--secondary-container);
    color: var(--on-secondary-container);
    font-size: var(--m3e-label-md-size);
    font-weight: 700;
  }

  .popular a {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--on-surface);
  }

  .muted {
    color: var(--on-surface-variant);
  }

  .empty {
    padding: var(--m3e-space-8) 0;
    text-align: center;
    color: var(--on-surface-variant);
  }
</style>
