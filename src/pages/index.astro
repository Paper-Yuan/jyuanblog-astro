---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import Icon from '@/components/Icon.astro';
import WidgetSidebar from '@/components/WidgetSidebar.astro';
import { getArticles, getPopular, getCategories } from '@/lib/api';
import { SITE } from '@/config/site';

const [{ list: articles }, popular, categories] = await Promise.all([
  getArticles({ page: 1, pageSize: SITE.pageSize }),
  getPopular(5).catch(() => []),
  getCategories().catch(() => []),
]);

const [feature, ...rest] = articles;
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <h1 class="type-display-md">{SITE.title}</h1>
    <p class="sub type-body-lg">{SITE.subtitle}</p>
    <div class="hero-actions">
      <a href="/blog" class="m3-button m3-button--filled">浏览全部文章</a>
      <a href="/search" class="m3-button m3-button--outlined">
        <Icon name="search" size={16} /> 搜索
      </a>
    </div>
  </section>

  <!--
    主区 + 侧栏。
    栅格只在 >= 1200px 摆成两列 —— 断点必须与「主列不变量」反推一致：
    主列 >= 840px（版心契约）+ 侧栏 280 + 间隙 24 = 1144，容器 1200 够用。
    若更早就摆两列（比如 1024px），主列会被压到 700 出头，
    卡片网格退化成单列窄条 —— 加了侧栏反而更难看，且不会报错。
  -->
  <div class="page-grid">
    <div class="main-col">
      <!-- 最新文章 -->
      <section class="section">
        <header class="section-head">
          <h2 class="type-headline-sm">最新文章</h2>
          <a href="/blog" class="more type-label-lg">全部 →</a>
        </header>

        {
          articles.length === 0 ? (
            <p class="empty">还没有已发布的文章。</p>
          ) : (
            <div class="grid m3-stagger">
              {feature && <ArticleCard article={feature} feature />}
              {rest.map((a) => (
                <ArticleCard article={a} />
              ))}
            </div>
          )
        }
      </section>

      <!-- 热门 + 分类 -->
      <section class="two-col">
        {
          popular.length > 0 && (
            <div class="m3-card panel">
              <h2 class="type-title-lg panel-title">热门文章</h2>
              <ol class="popular">
                {popular.map((a, i) => (
                  <li>
                    <span class="rank">{i + 1}</span>
                    <a href={`/blog/${a.slug}`}>{a.title}</a>
                    <span class="muted type-body-sm">{a.viewCount} 阅读</span>
                  </li>
                ))}
              </ol>
            </div>
          )
        }

        {
          categories.length > 0 && (
            <div class="m3-card panel">
              <h2 class="type-title-lg panel-title">分类</h2>
              <div class="cats">
                {categories.map((c) => (
                  <a href={`/categories/${c.slug}`} class="m3-chip">
                    <Icon name="folder" size={14} /> {c.name}
                    <span class="muted">{c.articleCount ?? 0}</span>
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </section>
    </div>

    <WidgetSidebar articles={articles} />
  </div>
</BaseLayout>

<style>
  .hero {
    padding: var(--m3e-space-5) 0 var(--m3e-space-4);
    text-align: center;
  }

  /*
   * 主区 + 侧栏。默认单列（侧栏落到主区下方），
   * 只在 xl 断点摆成两列 —— 理由见模板里的注释。
   */
  .page-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--m3e-space-6);
    margin-top: var(--m3e-space-5);
  }

  @media (min-width: 1200px) {
    .page-grid {
      grid-template-columns: minmax(0, 1fr) 280px;
    }
  }

  .main-col {
    min-width: 0;
  }

  .hero h1 {
    letter-spacing: -0.02em;
    background: linear-gradient(120deg, var(--primary), var(--tertiary) 85%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .sub {
    margin-top: var(--m3e-space-3);
    color: var(--on-surface-variant);
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--m3e-space-3);
    margin-top: var(--m3e-space-6);
  }

  .section {
    margin-top: var(--m3e-space-5);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--m3e-space-5);
  }

  .more {
    color: var(--primary);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--m3e-space-5);
  }

  :global(:root[data-layout='list']) .grid {
    grid-template-columns: 1fr;
  }


  .two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--m3e-space-5);
    margin-top: var(--m3e-space-8);
  }

  /* 与 ArticleCard 保持同一种容器语言：面板底色与页底仅差 1.05:1，需描边才有边界 */
  .panel {
    border: 1px solid var(--outline-variant);
  }

  .panel-title {
    margin-bottom: var(--m3e-space-4);
  }

  .popular {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--m3e-space-1);
  }

  .popular li {
    display: flex;
    align-items: center;
    gap: var(--m3e-space-3);
    padding: var(--m3e-space-2) 0;
  }

  .rank {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border-radius: var(--shape-corner-full);
    background: var(--secondary-container);
    color: var(--on-secondary-container);
    font-size: var(--m3e-label-md-size);
    font-weight: 700;
  }

  .popular a {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--on-surface);
  }

  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--m3e-space-2);
  }

  .muted {
    color: var(--on-surface-variant);
  }

  .empty {
    padding: var(--m3e-space-8) 0;
    text-align: center;
    color: var(--on-surface-variant);
  }
</style>
