---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTags, getAllArticles, type Tag } from '@/lib/api';

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map((t) => ({ params: { slug: t.slug }, props: { tag: t } }));
}

interface Props {
  tag: Tag;
}

const { tag } = Astro.props;
const all = await getAllArticles();
const articles = all.filter((a) => a.tags.some((t) => t.id === tag.id));
---

<BaseLayout title={`#${tag.name}`}>
  <header class="head">
    <nav class="crumb type-body-sm">
      <a href="/tags">标签</a>
      <span aria-hidden="true">/</span>
      <span>#{tag.name}</span>
    </nav>
    <h1 class="type-headline-lg">
      <span class="hash" style={tag.color ? `color:${tag.color}` : undefined}>#</span>
      {tag.name}
    </h1>
    <p class="muted type-body-sm">{articles.length} 篇</p>
  </header>

  {
    articles.length === 0 ? (
      <p class="empty">该标签下还没有文章。</p>
    ) : (
      <ul class="list">
        {articles.map((a) => (
          <li>
            <a href={`/blog/${a.id}`} class="row m3-card m3-card--interactive">
              <span class="title type-title-md">{a.title}</span>
              <span class="summary type-body-sm">{a.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .head {
    margin-bottom: var(--m3e-space-6);
  }

  .crumb {
    display: flex;
    gap: var(--m3e-space-2);
    margin-bottom: var(--m3e-space-3);
    color: var(--on-surface-variant);
  }

  .hash {
    color: var(--primary);
  }

  .muted {
    margin-top: var(--m3e-space-2);
    color: var(--on-surface-variant);
  }

  .list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--m3e-space-3);
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: var(--m3e-space-1);
    color: var(--on-surface);
  }

  .row:hover {
    text-decoration: none;
  }

  .summary {
    color: var(--on-surface-variant);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .empty {
    padding: var(--m3e-space-8) 0;
    text-align: center;
    color: var(--on-surface-variant);
  }
</style>
