---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getArticles } from '@/lib/api';

const page = 1;
const { list: articles, total } = await getArticles({ page, pageSize: 50 });
---

<BaseLayout title="博客">
  <header class="head">
    <h1 class="type-headline-lg">全部文章</h1>
    <p class="muted type-body-md">共 {total} 篇</p>
  </header>

  {
    articles.length === 0 ? (
      <p class="empty">还没有已发布的文章。</p>
    ) : (
      <div class="grid m3-stagger">
        {articles.map((a) => (
          <ArticleCard article={a} />
        ))}
      </div>
    )
  }

  <p class="hint type-body-sm">
    想按时间或分类浏览？试试 <a href="/archives">归档</a> 或 <a href="/categories">分类</a>。
  </p>
</BaseLayout>

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--m3e-space-4);
    margin-bottom: var(--m3e-space-6);
  }

  .muted {
    color: var(--on-surface-variant);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--m3e-space-5);
  }

  :global(:root[data-layout='list']) .grid {
    grid-template-columns: 1fr;
  }

  .empty {
    padding: var(--m3e-space-8) 0;
    text-align: center;
    color: var(--on-surface-variant);
  }

  .hint {
    margin-top: var(--m3e-space-8);
    color: var(--on-surface-variant);
  }
</style>
