---
/**
 * 文章详情页。
 *
 * 构建期完成：Markdown 渲染、TOC 抽取、阅读时长计算 —— 客户端零渲染成本。
 * 评论是动态的，由底部的客户端脚本从 API 拉取（静态页不能固化评论）。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Comments from '@/components/Comments.svelte';
import { getAllArticles, getArticle, type Article } from '@/lib/api';
import { renderMarkdown, formatDate, compactNumber, placeholderTint, safeColor } from '@/lib/format';
import { SITE } from '@/config/site';

export async function getStaticPaths() {
  const articles = await getAllArticles();
  return articles.map((a) => ({ params: { slug: String(a.slug) }, props: { article: a } }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;

// 详情（含正文）单独拉取
const detail = await getArticle(article.id);
const { html, toc, readingMinutes, wordCount } = renderMarkdown(detail.content);

// 相邻文章：按构建期列表顺序定位
const all = await getAllArticles();
const idx = all.findIndex((a) => a.id === article.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description: article.summary,
  datePublished: article.createdAt,
  dateModified: article.updatedAt,
  author: { '@type': 'Person', name: article.author.name },
  publisher: { '@type': 'Organization', name: SITE.title },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE.url}/blog/${article.slug}` },
  ...(article.coverImage ? { image: article.coverImage } : {}),
  ...(article.category ? { articleSection: article.category.name } : {}),
  ...(article.tags.length ? { keywords: article.tags.map((t) => t.name).join(', ') } : {}),
  wordCount,
};
---

<BaseLayout title={article.title} description={article.summary} jsonLd={jsonLd}>
  <div class="wrap">
    <!-- 正文 -->
    <article class="post" data-pagefind-body>
      <nav class="crumb type-body-sm">
        <a href="/blog">博客</a>
        {article.category && (
          <>
            <span aria-hidden="true">/</span>
            <a href={`/categories/${article.category.slug}`}>{article.category.name}</a>
          </>
        )}
      </nav>

      <h1 class="title type-headline-lg" data-pagefind-meta="title">{article.title}</h1>

      <div class="meta">
        <span class="stat"><Icon name="clock" size={15} /> {formatDate(article.createdAt)}</span>
        <span class="stat"><Icon name="clock" size={15} /> 约 {readingMinutes} 分钟</span>
        <span class="stat"><Icon name="eye" size={15} /> {compactNumber(article.viewCount)}</span>
        <span class="stat"><Icon name="comment" size={15} /> {article.commentCount}</span>
      </div>

      {article.tags.length > 0 && (
        <div class="tags">
          {article.tags.map((t) => {
            /* 标签色来自后台数据，过白名单再进 style（见 @/lib/format） */
            const c = safeColor(t.color);
            return (
              <a href={`/tags/${t.slug}`} class="m3-chip" style={c ? `color:${c}` : undefined}>
                # {t.name}
              </a>
            );
          })}
        </div>
      )}

      {article.coverImage && (
        <div class="cover-wrap m3-bloom" style={`--tint:${placeholderTint(article.title)}`}>
          <img class="cover" src={article.coverImage} alt={article.title} loading="eager" />
        </div>
      )}

      <div class="prose" set:html={html} />

      <!-- 上下篇 -->
      <nav class="adjacent" aria-label="相邻文章">
        {prev ? (
          <a href={`/blog/${prev.slug}`} class="adj m3-card">
            <span class="dir type-label-md"><Icon name="arrow-left" size={14} /> 上一篇</span>
            <span class="adj-title type-title-md">{prev.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a href={`/blog/${next.slug}`} class="adj m3-card next">
            <span class="dir type-label-md">下一篇 <Icon name="arrow-right" size={14} /></span>
            <span class="adj-title type-title-md">{next.title}</span>
          </a>
        ) : (
          <span />
        )}
      </nav>

      <!-- 评论：客户端从 API 拉取 -->
      <Comments articleId={article.id} client:idle />
    </article>

    <!-- 侧栏 TOC（桌面端） -->
    {
      toc.length > 1 && (
        <aside class="toc-wrap">
          <nav class="toc m3-card" aria-label="文章目录">
            <p class="toc-title type-label-lg">目录</p>
            <ul>
              {toc.map((item) => (
                <li class={`d${item.depth}`}>
                  <a href={`#${item.id}`}>{item.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</BaseLayout>

<script>
  // TOC 滚动高亮：IntersectionObserver，零依赖
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
  if (links.length) {
    const map = new Map<string, HTMLAnchorElement>();
    for (const l of links) map.set(decodeURIComponent(l.hash.slice(1)), l);

    const headings = Array.from(document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]'));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const link = map.get(e.target.id);
          if (!link) continue;
          if (e.isIntersecting) {
            links.forEach((l) => l.removeAttribute('aria-current'));
            link.setAttribute('aria-current', 'true');
          }
        }
      },
      // 顶部留出顶栏高度，避免高亮跳变
      { rootMargin: '-88px 0px -70% 0px', threshold: 0 }
    );
    headings.forEach((h) => io.observe(h));
  }
</script>

<style>
  .wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--m3e-space-6);
  }

  /*
   * 侧栏 TOC 只在 xl（>= 1200px）出现，整块版心按
   * 正文列 + TOC + 间隙 = 840 + 240 + 24 = 1104 反推，取 1120 留余量。
   * 关键在于**正文列是那个不可动的量**：若沿用 1100px 断点 + 1080px 版心，
   * 正文列只剩 816px，反而跌破了规范 840dp 的下界 —— 加个侧栏把阅读体验
   * 弄差了，这是最不易察觉又最伤阅读的一类回归。
   * 宽度不够宁可不显示侧栏，也不挤压正文。
   */
  @media (min-width: 1200px) {
    .wrap:has(.toc-wrap) {
      grid-template-columns: minmax(0, 1fr) 240px;
      max-width: 1120px;
      margin: 0 auto;
    }
  }

  .post {
    min-width: 0;
    max-width: var(--m3e-reading-max);
    margin: 0 auto;
    width: 100%;
  }

  .crumb {
    display: flex;
    gap: var(--m3e-space-2);
    margin-bottom: var(--m3e-space-3);
    color: var(--on-surface-variant);
  }

  .title {
    letter-spacing: -0.01em;
    margin-bottom: var(--m3e-space-4);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--m3e-space-4);
    color: var(--on-surface-variant);
    font-size: var(--m3e-label-md-size);
    margin-bottom: var(--m3e-space-4);
  }

  .stat {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--m3e-space-2);
    margin-bottom: var(--m3e-space-6);
  }

  /*
   * 头图容器。锁死 16:9 是为了把 CLS 压到 0：
   * 图片到达前容器已有确定高度，不会把下面的正文整体推下去。
   * 代价是比原图更方的图会被裁 —— 与卡片保持同一比例，视觉上更统一。
   */
  .cover-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--shape-corner-l);
    margin-bottom: var(--m3e-space-6);
    background: var(--tint, var(--surface-container-high));
  }

  /* 暗色下 placeholderTint 的浅色会照出一块近白，与暗表面混合压暗 */
  :global(:root.dark) .cover-wrap {
    background: color-mix(in srgb, var(--tint, var(--surface-container-high)) 22%, var(--surface-container-high));
  }

  .cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .adjacent {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--m3e-space-4);
    margin-top: var(--m3e-space-10);
  }

  .adj {
    display: flex;
    flex-direction: column;
    gap: var(--m3e-space-1);
    color: var(--on-surface);
  }

  .adj:hover {
    text-decoration: none;
    background: var(--surface-container);
  }

  .adj.next {
    text-align: right;
  }

  .dir {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--on-surface-variant);
  }

  .adj.next .dir {
    justify-content: flex-end;
  }

  .toc-wrap {
    display: none;
  }

  /* 断点必须与上面 .wrap 的栅格断点一致：否则会出现"栅格只有一列、
     TOC 却已显示"，TOC 会独自撑满整行，像一块走错位置的卡片。 */
  @media (min-width: 1200px) {
    .toc-wrap {
      display: block;
    }
  }

  .toc {
    position: sticky;
    top: calc(var(--m3e-topbar-h) + var(--m3e-space-5));
    padding: var(--m3e-space-4);
    max-height: calc(100vh - var(--m3e-topbar-h) - var(--m3e-space-10));
    overflow-y: auto;
  }

  .toc-title {
    margin-bottom: var(--m3e-space-3);
    color: var(--on-surface-variant);
  }

  .toc ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc a {
    display: block;
    padding: 4px var(--m3e-space-2);
    border-radius: var(--shape-corner-xs);
    color: var(--on-surface-variant);
    font-size: var(--m3e-body-sm-size);
    line-height: 1.5;
    border-left: 2px solid transparent;
    transition: color var(--m3e-duration-short) var(--m3e-easing-standard);
  }

  .toc a:hover {
    color: var(--on-surface);
    text-decoration: none;
  }

  .toc a[aria-current] {
    color: var(--primary);
    font-weight: 600;
    border-left-color: var(--primary);
    background: color-mix(in srgb, var(--primary) 8%, transparent);
  }

  .toc .d3 a {
    padding-left: var(--m3e-space-4);
  }
</style>
