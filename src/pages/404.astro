---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" showNav={true}>
  <div class="wrap">
    <p class="code type-display-lg" aria-hidden="true">404</p>
    <h1 class="type-headline-sm">找不到这个页面</h1>
    <p class="muted">链接可能已经失效，或者文章被下架了。</p>
    <div class="actions">
      <a href="/" class="m3-button m3-button--filled">回到首页</a>
      <a href="/blog" class="m3-button m3-button--outlined">浏览博客</a>
      <a href="/search" class="m3-button">搜索</a>
    </div>
  </div>
</BaseLayout>

<style>
  .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--m3e-space-3);
    padding: var(--m3e-space-10) 0;
    text-align: center;
  }

  .code {
    font-weight: 700;
    line-height: 1;
    background: linear-gradient(120deg, var(--primary), var(--tertiary));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .muted {
    color: var(--on-surface-variant);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--m3e-space-3);
    margin-top: var(--m3e-space-4);
  }
</style>
