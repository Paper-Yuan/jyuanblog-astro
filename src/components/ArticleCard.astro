---
/**
 * 文章卡片。网格/列表两种形态由 <html data-layout> 控制。
 *
 * ⚠️ 不要用"整卡套一个 <a>"的写法：卡片里还有分类链接，
 *    嵌套 <a> 是非法 HTML，浏览器解析时会自动闭合外层 <a>，
 *    导致正文区被挤出链接之外（表现为封面下方多出大片空白）。
 *    这里改用 stretched-link 模式：标题是唯一的文章链接，
 *    由它的 ::after 覆盖整卡；分类链接用 z-index 提到覆盖层之上。
 */
import Icon from './Icon.astro';
import { formatDate, compactNumber, placeholderTint } from '@/lib/format';
import type { Article } from '@/lib/api';

interface Props {
  article: Article;
  /** 首篇卡片放大展示（首页顶部） */
  feature?: boolean;
}

const { article, feature = false } = Astro.props;

const href = `/blog/${article.id}`;
const tint = placeholderTint(article.title);
// 显式拼接类名而非 class:* 指令：astro check 对指令的元素类型推断有误报
const cardClass = `card m3-card m3-card--interactive${feature ? ' feature' : ''}`;
const titleClass = 'title';
---

<article class={cardClass}>
  <div class="cover" style={`--tint:${tint}`}>
    {
      article.coverImage ? (
        <img src={article.coverImage} alt={article.title} loading="lazy" decoding="async" />
      ) : (
        <span class="cover-fallback" aria-hidden="true">{article.title.slice(0, 1)}</span>
      )
    }
  </div>

  <div class="body">
    <div class="meta">
      {
        article.category && (
          <a href={`/categories/${article.category.slug}`} class="m3-chip is-interactive">
            {article.category.name}
          </a>
        )
      }
      {article.isTop && <span class="pin">置顶</span>}
    </div>

    <h2 class={titleClass}>
      <a href={href} class="link">{article.title}</a>
    </h2>

    <p class="summary">{article.summary}</p>

    <div class="foot">
      <span class="stat"><Icon name="clock" size={14} /> {formatDate(article.createdAt)}</span>
      <span class="stat"><Icon name="eye" size={14} /> {compactNumber(article.viewCount)}</span>
      <span class="stat"><Icon name="comment" size={14} /> {article.commentCount}</span>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative; /* stretched-link 的定位基准 */
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    /* 卡片表面与页面底色仅差 1.05:1，加一条描边才有可见边界 */
    border: 1px solid var(--outline-variant);
  }

  /* 标题里的链接铺满整卡，实现"整卡可点"而不嵌套 <a> */
  .link {
    color: inherit;
  }

  .link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .link:hover,
  .link:focus-visible {
    text-decoration: none;
  }

  /* 卡片内其他可点元素需浮到覆盖层之上 */
  .is-interactive {
    position: relative;
    z-index: 2;
  }

  .cover {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    /* 占位色由主题色相派生；暗色下压暗，避免深色页面上闪一块近白 */
    background: var(--tint, var(--surface-container-high));
  }

  /* 暗色下 placeholderTint 的浅色会闪出一块近白，这里与暗表面混合压暗 */
  :global(:root.dark) .cover {
    background: color-mix(in srgb, var(--tint, var(--surface-container-high)) 22%, var(--surface-container-high));
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--m3e-duration-long) var(--m3e-easing-emphasized-decelerate);
  }

  /* hover 反馈挂在卡片上（链接覆盖层吃不到 :hover 的兄弟元素） */
  .card:hover .cover img {
    transform: scale(1.04);
  }

  .card:hover .title {
    color: var(--primary);
  }

  .cover-fallback {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--primary-container), var(--secondary-container));
    color: var(--on-primary-container);
    font-size: 2.5rem;
    font-weight: 700;
    opacity: 0.9;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--m3e-space-2);
    padding: var(--m3e-space-5);
    flex: 1;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--m3e-space-2);
    min-height: 32px;
  }

  /* 既无分类也无置顶时不要留出空行 */
  .meta:empty {
    display: none;
  }

  .pin {
    padding: 2px 8px;
    border-radius: var(--shape-corner-s);
    background: var(--primary);
    color: var(--on-primary);
    font-size: var(--m3e-label-md-size);
    font-weight: 600;
  }

  .title {
    font-size: var(--m3e-title-lg-size);
    line-height: var(--m3e-title-lg-line);
    font-weight: 600;
    color: var(--on-surface);
    transition: color var(--m3e-duration-short) var(--m3e-easing-standard);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }


  .summary {
    color: var(--on-surface-variant);
    font-size: var(--m3e-body-md-size);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--m3e-space-4);
    margin-top: var(--m3e-space-2);
    /* 用 on-surface 而非 on-surface-variant：12px 小字经抗锯齿后
       实测对比度只有 4.15:1，低于 AA 的 4.5:1 */
    color: var(--on-surface);
    font-size: 0.8125rem;
  }

  .stat {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* 列表布局：横向排列，封面固定宽度 */
  :global(:root[data-layout='list']) .card {
    flex-direction: row;
  }

  :global(:root[data-layout='list']) .cover {
    width: 240px;
    flex-shrink: 0;
    aspect-ratio: 16 / 10;
  }


  @media (max-width: 640px) {
    :global(:root[data-layout='list']) .card {
      flex-direction: column;
    }

    :global(:root[data-layout='list']) .cover {
      width: 100%;
      aspect-ratio: 16 / 9;
    }
  }
</style>
