---
/**
 * 内联 SVG 图标集。
 *
 * 不引入 astro-icon / iconify（省一个依赖与一次客户端查询），
 * 只内联站点真正用到的一小撮图标。
 */
interface Props {
  name:
    | 'menu'
    | 'close'
    | 'search'
    | 'settings'
    | 'sun'
    | 'moon'
    | 'auto'
    | 'home'
    | 'archive'
    | 'tag'
    | 'folder'
    | 'rss'
    | 'github'
    | 'arrow-left'
    | 'arrow-right'
    | 'clock'
    | 'eye'
    | 'comment'
    | 'heart'
    | 'grid'
    | 'list'
    | 'link';
  size?: number;
  label?: string;
}

const { name, size = 20, label } = Astro.props;

// 24x24 viewBox，仅描边路径（stroke-based），与 M3 图标风格一致
