---
/**
 * 顶栏：站名 + 导航 + 搜索入口 + 显示设置触发。
 * 移动端导航折叠为抽屉。
 */
import Icon from './Icon.astro';
import { SITE, NAV } from '@/config/site';

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="topbar">
  <div class="m3-layout inner">
    <a href="/" class="brand" aria-label={`${SITE.title} 首页`}>
      <span class="brand-mark" aria-hidden="true">千</span>
      <span class="brand-text">{SITE.title}</span>
      <!-- 上游 Shirone 的招牌细节：品牌旁一根短标，悬停时"抽线"变长 -->
      <span class="brand-thread" aria-hidden="true"></span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        NAV.map((item) => (
          <a href={item.href} class="nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={SITE.adminUrl} class="nav-link nav-admin">管理</a>
    </nav>

    <div class="actions">
      <a href="/search" class="m3-icon-btn" aria-label="搜索">
        <Icon name="search" />
      </a>

      <!--
        明暗一键切换。放在顶栏而不是藏进设置面板：
        这是使用频率最高的一次操作，为它开一层浮层是错的比例。
        点一下在亮/暗之间切换；「跟随系统」这一档留在面板与悬浮栏里。
      -->
      <button
        id="theme-toggle"
        class="m3-icon-btn theme-toggle"
        type="button"
        data-mode="light"
        aria-label="切到暗色"
        title="切到暗色"
      >
        <span class="ico ico-light" aria-hidden="true"><Icon name="sun" /></span>
        <span class="ico ico-dark" aria-hidden="true"><Icon name="moon" /></span>
        <span class="ico ico-auto" aria-hidden="true"><Icon name="auto" /></span>
      </button>

      <!-- 访客账号入口。登录态由客户端脚本按需替换文案（静态页无会话） -->
      <a href="/login" class="nav-link nav-account" data-account-link>登录</a>

      <!--
        显示设置：Svelte 岛，点击才加载。
        按钮上带一枚色相回显点 —— 不打开面板也能看见"现在调成了什么色"。
      -->
      <button
        id="settings-trigger"
        class="m3-icon-btn"
        type="button"
        aria-label="显示设置"
        aria-haspopup="dialog"
      >
        <Icon name="settings" />
        <span class="hue-dot" aria-hidden="true"></span>
      </button>

      <button
        id="mobile-nav-trigger"
        class="m3-icon-btn mobile-only"
        type="button"
        aria-label="打开导航"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="移动导航" hidden>
    {
      NAV.map((item) => (
        <a href={item.href} class="mobile-link" aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
    <a href="/login" class="mobile-link" data-account-link-mobile>登录</a>
    <a href={SITE.adminUrl} class="mobile-link">管理后台</a>
  </nav>
</header>

<script>
  /**
   * 顶栏的三个小交互：移动抽屉、账号入口回显、明暗一键切换 + 色相回显。
   *
   * 刻意写在这里而不是水合一个 Svelte 岛：顶栏每页都在，
   * 为了三个按钮付一份岛的成本不划算。逻辑只读 @/lib/theme 的轻量层
   * （不含 HCT 引擎），改完设置由 updateSettings() 广播给设置面板与悬浮栏。
   */
  import {
    readSettings,
    updateSettings,
    resolveMode,
    SETTINGS_EVENT,
    DEFAULT_SETTINGS,
  } from '@/lib/theme';

  const trigger = document.getElementById('mobile-nav-trigger');
  const panel = document.getElementById('mobile-nav');
  trigger?.addEventListener('click', () => {
    if (!panel) return;
    const open = panel.hasAttribute('hidden');
    panel.toggleAttribute('hidden', !open);
    trigger.setAttribute('aria-expanded', String(open));
  });

  /**
   * 顶栏账号入口：已登录则显示用户名并指向个人资料，未登录显示"登录"。
   * 这里只读 localStorage 改两个属性，代价接近于零。
   * ★ 桌面与移动抽屉各有一个入口，两处都要替换，否则窄屏上会露出"登录"字样。
   */
  (function () {
    const links = Array.from(
      document.querySelectorAll<HTMLElement>('[data-account-link], [data-account-link-mobile]')
    );
    if (!links.length) return;
    const KEY = 'jyuanblog:user-profile';
    let user = null;
    try {
      const raw = localStorage.getItem(KEY);
      if (raw) user = JSON.parse(raw);
    } catch {}
    if (!user || !user.username) return;
    const href = user.role === 9 ? '/admin/' : '/';
    const title = user.role === 9 ? '进入管理后台' : '已登录';
    for (const link of links) {
      link.textContent = user.username;
      link.setAttribute('href', href);
      link.setAttribute('title', title);
    }
  })();

  /* ---- 明暗一键切换 ---- */
  const themeBtn = document.getElementById('theme-toggle');

  /** 按钮上只留一个图标：图标即"当前状态"的回显，而不是"我要做什么" */
  function syncThemeBtn() {
    if (!themeBtn) return;
    const s = readSettings();
    const eff = resolveMode(s.mode);
    themeBtn.dataset.mode = s.mode === 'auto' ? `auto-${eff}` : s.mode;
    // 文案说"点下去会发生什么"，比说"现在是什么"更好用
    const next = eff === 'dark' ? '亮色' : '暗色';
    const label = s.mode === 'auto' ? `跟随系统（当前 ${eff === 'dark' ? '暗色' : '亮色'}），点击切到${next}` : `切到${next}`;
    themeBtn.setAttribute('aria-label', label);
    themeBtn.title = label;
  }

  themeBtn?.addEventListener('click', () => {
    const s = readSettings();
    // auto 时先按"当前实际是亮还是暗"来翻转，否则在暗色系统上点一下会
    // 从 auto 变成 light —— 看起来什么都没发生，第二次点击才生效。
    const next = resolveMode(s.mode) === 'dark' ? 'light' : 'dark';
    updateSettings({ mode: next });
  });

  /* ---- 色相回显：不打开面板也能看见现在调成了什么色 ---- */
  const hueDot = document.querySelector<HTMLElement>('#settings-trigger .hue-dot');

  function syncHueDot() {
    if (!hueDot) return;
    const s = readSettings();
    hueDot.style.setProperty('--hue-val', String(s.hue));
    hueDot.dataset.custom = String(s.hue !== DEFAULT_SETTINGS.hue);
  }

  window.addEventListener(SETTINGS_EVENT, () => {
    syncThemeBtn();
    syncHueDot();
  });
  syncThemeBtn();
  syncHueDot();
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: var(--z-shell);
    height: var(--m3e-topbar-h);
    /* 色调表面层次而非玻璃拟态。Shirone 规范明确要求"严禁毛玻璃效果"——
       背景模糊会让正文在滚动经过时变得不可读，而顶栏承载导航文字。
       这里改用「不透明的 surface 派生色」，滚动后由动画抬到更高的层次。 */
    background: color-mix(in srgb, var(--surface) 96%, var(--primary) 4%);
    border-bottom: 1px solid var(--outline-variant);
    /* 让顶栏在跨文档导航时保持同一元素身份 —— 翻页时内容区过渡，顶栏不动。
       这就是 Shirone 说的 persistent shell 观感。同名元素每页必须唯一。 */
    view-transition-name: topbar;
  }

  .inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--m3e-space-6);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--m3e-space-3);
    color: var(--on-surface);
    flex-shrink: 0;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--shape-corner-m);
    background: var(--primary);
    color: var(--on-primary);
    font-weight: 700;
    font-size: var(--m3e-title-md-size);
  }

  .brand-text {
    font-size: var(--m3e-title-lg-size);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* 品牌旁的一根"线头"：静止时 14px 高，悬停抽到 26px。
     150ms 内完成 —— 这是交互反馈，不能用环境动效的时长。
     刻意用竖条而不是横杠：横杠在站名后面会被读成连字符"-"。 */
  .brand-thread {
    width: 4px;
    height: 14px;
    border-radius: var(--shape-corner-full);
    background: var(--primary);
    transition: height var(--m3e-duration-short3) var(--m3e-easing-emphasized);
  }

  .brand:hover .brand-thread {
    height: 26px;
  }

  /* 站名走展示字体：品牌字在顶栏就该出现，不必等到正文 */
  .brand-text {
    font-family: var(--m3e-font-display);
  }

  /* ---- 明暗切换：一个按钮三枚图标，靠 data-mode 选一枚 ---- */
  .theme-toggle .ico {
    display: none;
    place-items: center;
  }

  .theme-toggle[data-mode='light'] .ico-light,
  .theme-toggle[data-mode='dark'] .ico-dark,
  .theme-toggle[data-mode='auto-dark'] .ico-auto,
  .theme-toggle[data-mode='auto-light'] .ico-auto {
    display: grid;
  }

  /* 图标换完做一次极短的转身：让"状态变了"这件事被看见，
     但只有 200ms，不至于让一次点击显得拖沓 */
  @media (prefers-reduced-motion: no-preference) {
    :root:not(.motion-reduced) .theme-toggle .ico {
      animation: m3-ico-turn var(--m3e-duration-short4) var(--m3e-easing-emphasized-decelerate) both;
    }
  }

  @keyframes m3-ico-turn {
    from {
      opacity: 0;
      transform: rotate(-40deg) scale(0.8);
    }
  }

  /* ---- 色相回显点 ---- */
  .hue-dot {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 8px;
    height: 8px;
    border-radius: var(--shape-corner-full);
    /* 颜色 = 访客当前色相本身（与设置面板的色板同一算法），不是随手挑的一个色 */
    background: oklch(0.62 0.16 var(--hue-val, 315));
    box-shadow: 0 0 0 1.5px var(--surface);
  }

  .hue-dot[data-custom='false'] {
    /* 出厂色相不必强调"你改过"，压到 55% 即可 */
    opacity: 0.55;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--m3e-space-1);
    margin-left: auto;
  }

  .nav-link {
    padding: var(--m3e-space-2) var(--m3e-space-3);
    border-radius: var(--shape-corner-s);
    color: var(--on-surface-variant);
    font-size: var(--m3e-label-lg-size);
    transition: background var(--m3e-duration-short) var(--m3e-easing-standard);
  }

  .nav-link:hover {
    background: color-mix(in srgb, var(--on-surface) 8%, transparent);
    color: var(--on-surface);
    text-decoration: none;
  }

  /* 按下反馈比 hover 重一档，且用最短时长才跟手 */
  .nav-link:active {
    background: color-mix(in srgb, var(--on-surface) 12%, transparent);
    transition-duration: var(--m3e-duration-short1);
  }

  .nav-link[aria-current='page'] {
    color: var(--primary);
    font-weight: 600;
    background: color-mix(in srgb, var(--primary) 16%, transparent);
  }

  .nav-admin {
    color: var(--primary);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--m3e-space-1);
    margin-left: auto;
  }

  .nav + .actions {
    margin-left: 0;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    padding: var(--m3e-space-2) var(--m3e-space-6) var(--m3e-space-4);
    background: var(--surface-container-low);
    border-bottom: 1px solid var(--outline-variant);
  }

  .mobile-link {
    padding: var(--m3e-space-3);
    border-radius: var(--shape-corner-s);
    color: var(--on-surface-variant);
    font-size: var(--m3e-body-lg-size);
  }

  .mobile-link[aria-current='page'] {
    color: var(--primary);
    font-weight: 600;
    background: color-mix(in srgb, var(--primary) 16%, transparent);
  }

  .mobile-only {
    display: none;
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }

    .mobile-only {
      display: inline-grid;
    }

    .mobile-nav:not([hidden]) {
      display: flex;
    }
  }

  /* 顶栏在窄屏要腾出位置给「明暗 + 设置 + 菜单」三枚图标。
     账号入口收进抽屉，而不是把三枚图标挤成 32px —— 触控目标 48dp 是硬指标。 */
  @media (max-width: 560px) {
    .nav-account {
      display: none;
    }
  }
</style>
