---
/**
 * 顶栏：站名 + 导航 + 搜索入口 + 显示设置触发。
 * 移动端导航折叠为抽屉。
 */
import Icon from './Icon.astro';
import { SITE, NAV } from '@/config/site';

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="topbar">
  <div class="m3-layout inner">
    <a href="/" class="brand" aria-label={`${SITE.title} 首页`}>
      <span class="brand-mark" aria-hidden="true">千</span>
      <span class="brand-text">{SITE.title}</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        NAV.map((item) => (
          <a href={item.href} class="nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={SITE.adminUrl} class="nav-link nav-admin">管理</a>
    </nav>

    <div class="actions">
      <a href="/search" class="m3-icon-btn" aria-label="搜索">
        <Icon name="search" />
      </a>

      <!-- 访客账号入口。登录态由客户端脚本按需替换文案（静态页无会话） -->
      <a href="/login" class="nav-link nav-account" data-account-link>登录</a>

      <!-- 显示设置：Svelte 岛，点击才加载 -->
      <button
        id="settings-trigger"
        class="m3-icon-btn"
        type="button"
        aria-label="显示设置"
        aria-haspopup="dialog"
      >
        <Icon name="settings" />
      </button>

      <button
        id="mobile-nav-trigger"
        class="m3-icon-btn mobile-only"
        type="button"
        aria-label="打开导航"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="移动导航" hidden>
    {
      NAV.map((item) => (
        <a href={item.href} class="mobile-link" aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
    <a href={SITE.adminUrl} class="mobile-link">管理后台</a>
  </nav>
</header>

<script>
  // 移动端抽屉：纯 DOM，无需框架
  const trigger = document.getElementById('mobile-nav-trigger');
  const panel = document.getElementById('mobile-nav');
  trigger?.addEventListener('click', () => {
    if (!panel) return;
    const open = panel.hasAttribute('hidden');
    panel.toggleAttribute('hidden', !open);
    trigger.setAttribute('aria-expanded', String(open));
  });

  /**
   * 顶栏账号入口：已登录则显示用户名并指向个人资料，未登录显示"登录"。
   *
   * 这段刻意写在顶栏而不是 Svelte 岛里 —— 顶栏在每一页都会渲染，
   * 为了一个文字替换去水合一个岛不划算（会破坏"默认访客零 JS"的契约）。
   * 这里只读 localStorage 改两个属性，代价接近于零。
   */
  (function () {
    const link = document.querySelector('[data-account-link]');
    if (!link) return;
    const KEY = 'jyuanblog:user-profile';
    let user = null;
    try {
      const raw = localStorage.getItem(KEY);
      if (raw) user = JSON.parse(raw);
    } catch {}
    if (!user || !user.username) return;
    link.textContent = user.username;
    link.setAttribute('href', user.role === 9 ? '/admin/' : '/');
    link.setAttribute('title', user.role === 9 ? '进入管理后台' : '已登录');
  })();
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--m3e-topbar-h);
    /* 色调表面层次而非玻璃拟态。Shirone 规范明确要求"严禁毛玻璃效果"——
       背景模糊会让正文在滚动经过时变得不可读，而顶栏承载导航文字。
       这里改用「不透明的 surface 派生色」，滚动后由动画抬到更高的层次。 */
    background: color-mix(in srgb, var(--surface) 96%, var(--primary) 4%);
    border-bottom: 1px solid var(--outline-variant);
    /* 让顶栏在跨文档导航时保持同一元素身份 —— 翻页时内容区过渡，顶栏不动。
       这就是 Shirone 说的 persistent shell 观感。同名元素每页必须唯一。 */
    view-transition-name: topbar;
  }

  .inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--m3e-space-6);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--m3e-space-3);
    color: var(--on-surface);
    flex-shrink: 0;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--shape-corner-m);
    background: var(--primary);
    color: var(--on-primary);
    font-weight: 700;
    font-size: var(--m3e-title-md-size);
  }

  .brand-text {
    font-size: var(--m3e-title-lg-size);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--m3e-space-1);
    margin-left: auto;
  }

  .nav-link {
    padding: var(--m3e-space-2) var(--m3e-space-3);
    border-radius: var(--shape-corner-s);
    color: var(--on-surface-variant);
    font-size: var(--m3e-label-lg-size);
    transition: background var(--m3e-duration-short) var(--m3e-easing-standard);
  }

  .nav-link:hover {
    background: color-mix(in srgb, var(--on-surface) 8%, transparent);
    color: var(--on-surface);
    text-decoration: none;
  }

  /* 按下反馈比 hover 重一档，且用最短时长才跟手 */
  .nav-link:active {
    background: color-mix(in srgb, var(--on-surface) 12%, transparent);
    transition-duration: var(--m3e-duration-short1);
  }

  .nav-link[aria-current='page'] {
    color: var(--primary);
    font-weight: 600;
    background: color-mix(in srgb, var(--primary) 16%, transparent);
  }

  .nav-admin {
    color: var(--primary);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--m3e-space-1);
    margin-left: auto;
  }

  .nav + .actions {
    margin-left: 0;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    padding: var(--m3e-space-2) var(--m3e-space-6) var(--m3e-space-4);
    background: var(--surface-container-low);
    border-bottom: 1px solid var(--outline-variant);
  }

  .mobile-link {
    padding: var(--m3e-space-3);
    border-radius: var(--shape-corner-s);
    color: var(--on-surface-variant);
    font-size: var(--m3e-body-lg-size);
  }

  .mobile-link[aria-current='page'] {
    color: var(--primary);
    font-weight: 600;
    background: color-mix(in srgb, var(--primary) 16%, transparent);
  }

  .mobile-only {
    display: none;
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }

    .mobile-only {
      display: inline-grid;
    }

    .mobile-nav:not([hidden]) {
      display: flex;
    }
  }
</style>
