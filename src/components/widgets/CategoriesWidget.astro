---
/**
 * 分类 —— 悬浮栏「分类」分区的内容。
 *
 * ★ 它曾经是侧栏里一张带 `<details>` 折叠头的卡片，现在搬进了常驻悬浮栏：
 *   折叠由悬浮栏整体负责（图标条 ↔ 面板），分区内部再套一层 details 就会出现
 *   "两层折叠、状态互相看不见"的怪东西。所以这里只渲染内容本身，
 *   外壳（浮层圆角、发丝线、头部标题）由 SideDock 统一给。
 *
 * ★ 2026-09-19：/categories 与 /categories/:slug 已删除，分类页并入归档页的
 *   筛选态 `?category=slug`。栏里点一条分类 = 把归档筛到这一类，
 *   读者仍然停在同一份列表上。
 */
import { getCategories } from '@/lib/api';
import Icon from '../Icon.astro';

const categories = await getCategories().catch(() => []);
const total = categories.reduce((s, c) => s + (c.articleCount ?? 0), 0);
/* 整站是构建期生成的，`/archives?category=x` 与 `/archives` 是同一个文件 ——
   所以"当前筛的是哪一条"**不可能**在服务端知道，只能由归档页的脚本回填
   （它按 data-filter-cat 找节点，页面里的片块与这里的链接一起点亮）。 */
const hrefOf = (slug: string) => `/archives?category=${encodeURIComponent(slug)}`;
---

{
  categories.length > 0 && (
    <div class="categories">
      <ul class="list">
        {categories.map((c) => (
          <li>
            <a href={hrefOf(c.slug)} data-filter-cat={c.slug}>
              <Icon name="folder" size={14} />
              <span class="text">{c.name}</span>
              <span class="n type-label-md">{c.articleCount ?? 0}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="foot type-body-sm">共 {total} 篇文章 · 点开即在归档里筛选</p>
    </div>
  )
}

<style>
  .categories {
    display: flex;
    flex-direction: column;
    gap: var(--m3e-space-2);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    list-style: none;
  }

  .list a {
    display: flex;
    align-items: center;
    gap: var(--m3e-space-2);
    padding: var(--m3e-space-2);
    border-radius: var(--shape-corner-s);
    color: var(--on-surface);
    transition: background var(--m3e-duration-short) var(--m3e-easing-standard);
  }

  .list a:hover {
    background: var(--surface-container-high);
    text-decoration: none;
  }

  /* 归档页正筛在这条分类上：由归档页的脚本回填 aria-current，
     静态渲染时它不存在（服务端读不到查询参数） */
  .list a[aria-current='true'] {
    background: color-mix(in srgb, var(--primary) 14%, transparent);
    color: var(--primary);
    font-weight: 600;
  }

  .text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .n {
    color: var(--on-surface-variant);
    font-variant-numeric: tabular-nums;
  }

  .foot {
    margin: 0;
    color: var(--on-surface-variant);
  }
</style>
