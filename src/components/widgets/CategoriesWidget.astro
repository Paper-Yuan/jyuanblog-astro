---
/**
 * 分类 —— 悬浮栏「分类」分区的内容。
 *
 * ★ 它曾经是侧栏里一张带 `<details>` 折叠头的卡片，现在搬进了常驻悬浮栏：
 *   折叠由悬浮栏整体负责（图标条 ↔ 面板），分区内部再套一层 details 就会出现
 *   "两层折叠、状态互相看不见"的怪东西。所以这里只渲染内容本身，
 *   外壳（28px 浮层、发丝线、头部标题）由 SideDock 统一给。
 */
import { getCategories } from '@/lib/api';
import Icon from '../Icon.astro';

const categories = await getCategories().catch(() => []);
const total = categories.reduce((s, c) => s + (c.articleCount ?? 0), 0);
/* 悬浮栏跨页常驻，所以它得知道"当前正停在哪一页"—— 否则它只是一堆链接，
   读者无法从栏里读出自己所处的位置 */
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

{
  categories.length > 0 && (
    <div class="categories">
      <ul class="list">
        {categories.map((c) => (
          <li>
            <a
              href={`/categories/${c.slug}`}
              aria-current={current === `/categories/${c.slug}` ? 'page' : undefined}
            >
              <Icon name="folder" size={14} />
              <span class="text">{c.name}</span>
              <span class="n type-label-md">{c.articleCount ?? 0}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="foot type-body-sm">共 {total} 篇文章</p>
    </div>
  )
}

<style>
  .categories {
    display: flex;
    flex-direction: column;
    gap: var(--m3e-space-2);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    list-style: none;
  }

  .list a {
    display: flex;
    align-items: center;
    gap: var(--m3e-space-2);
    padding: var(--m3e-space-2);
    border-radius: var(--shape-corner-s);
    color: var(--on-surface);
    transition: background var(--m3e-duration-short) var(--m3e-easing-standard);
  }

  .list a:hover {
    background: var(--surface-container-high);
    text-decoration: none;
  }

  /* 当前页正在这条分类上：给个静态指向，别让读者以为自己点错了 */
  .list a[aria-current='page'] {
    background: color-mix(in srgb, var(--primary) 14%, transparent);
    color: var(--primary);
    font-weight: 600;
  }

  .text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .n {
    color: var(--on-surface-variant);
    font-variant-numeric: tabular-nums;
  }

  .foot {
    margin: 0;
    color: var(--on-surface-variant);
  }
</style>
