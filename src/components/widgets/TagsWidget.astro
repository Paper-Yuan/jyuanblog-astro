---
/**
 * 标签部件 —— 可折叠的标签片。
 *
 * 标签自带颜色（后端 `tags.color`），这里用它做左边框以保留可辨识度，
 * 但**背景仍走主题容器色**：直接用标签色当底色会在深色主题下出现对比度不足。
 */
import { getTags } from '@/lib/api';

const tags = await getTags().catch(() => []);
---

{
  tags.length > 0 && (
    <details class="m3-card widget tags" open>
      <summary class="head">
        <span class="type-label-lg">标签</span>
        <span class="count type-label-md">{tags.length}</span>
      </summary>
      <div class="cloud">
        {tags.map((t) => (
          <a
            href={`/tags/${t.slug}`}
            class="m3-chip"
            style={t.color ? `--tag-color:${t.color}` : undefined}
          >
            # {t.name}
            <span class="n">{t.articleCount ?? 0}</span>
          </a>
        ))}
      </div>
    </details>
  )
}

<style>
  .widget {
    border: 1px solid var(--outline-variant);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
    color: var(--on-surface-variant);
  }

  .head::-webkit-details-marker {
    display: none;
  }

  .count {
    padding: 0 var(--m3e-space-2);
    border-radius: var(--shape-corner-full);
    background: var(--surface-container-high);
  }

  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--m3e-space-2);
    margin-top: var(--m3e-space-3);
  }

  /* 有颜色时只染文字与左边框，不染底 —— 标签色由用户数据决定，
     它可能是任何亮度，当底色无法保证与文字有 4.5:1 */
  .cloud a {
    color: var(--tag-color, var(--on-surface-variant));
    border-left: 2px solid var(--tag-color, transparent);
  }

  .n {
    color: var(--on-surface-variant);
    font-variant-numeric: tabular-nums;
  }
</style>
