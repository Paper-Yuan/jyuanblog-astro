---
/**
 * 标签 —— 悬浮栏「标签」分区的内容。
 *
 * 标签自带颜色（后端 `tags.color`），这里用它只染文字与左边框，
 * **不做底色**：标签色由用户数据决定，它可能是任何亮度，
 * 当底色无法保证与文字有 4.5:1（暗色主题下尤其危险）。
 *
 * 外壳（浮层圆角、标题、折叠）由 SideDock 统一给，这里只出内容。
 * ★ 2026-09-19：/tags 与 /tags/:slug 已删除，标签页并入归档页的筛选态
 *   `?tag=slug`（与分类可叠加）。当前筛的是哪一枚由归档页脚本回填 aria-current，
 *   服务端读不到查询参数（静态站的 `/archives?tag=x` 就是 `/archives` 同一个文件）。
 */
import { getTags } from '@/lib/api';
import { safeColor } from '@/lib/format';

const tags = await getTags().catch(() => []);

/** 颜色先过白名单再进模板：见 @/lib/format 的 safeColor */
const items = tags.map((t) => ({
  ...t,
  color: safeColor(t.color),
  href: `/archives?tag=${encodeURIComponent(t.slug)}`,
}));
---

{
  items.length > 0 && (
    <div class="tags">
      <div class="cloud">
        {items.map((t) => (
          <a
            href={t.href}
            class="m3-chip"
            data-filter-tag={t.slug}
            style={t.color ? `--tag-color:${t.color}` : ''}
          >
            # {t.name}
            <span class="n">{t.articleCount ?? 0}</span>
          </a>
        ))}
      </div>
      <p class="foot type-body-sm">点标签即在归档里筛选</p>
    </div>
  )
}

<style>
  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--m3e-space-2);
  }

  .cloud a {
    /* 标签色向"当前主题的正文色"拉 35% 再用：
       数据库里的标签色可能是任何亮度，直接当文字色会在暗色主题下
       出现 #ffd 压 #1a1a1a 那种 1.6:1 的不可读组合。
       拉向 on-surface 后无论明暗都保底可读；纯色仍留在左边框上做识别。 */
    color: color-mix(in oklab, var(--tag-color, var(--on-surface-variant)) 65%, var(--on-surface));
    border-left: 2px solid var(--tag-color, transparent);
  }

  .cloud a[aria-current='true'] {
    background: var(--secondary-container);
    color: var(--on-secondary-container);
    font-weight: 600;
  }

  .n {
    color: var(--on-surface-variant);
    font-variant-numeric: tabular-nums;
  }

  .foot {
    margin: var(--m3e-space-3) 0 0;
    color: var(--on-surface-variant);
  }
</style>
