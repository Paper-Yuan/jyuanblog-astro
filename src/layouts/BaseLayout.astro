---
/**
 * 基础布局。
 *
 * 关键点：出厂配色在**构建期**算好直接写进 <style>，因此默认访客零 JS 就有正确配色；
 * 改过设置的访客由内联脚本注入 localStorage 里缓存的 CSS，同样不闪。
 */
import '@/styles/variables.css';
import '@/styles/main.css';
import TopAppBar from '@/components/TopAppBar.astro';
import Footer from '@/components/Footer.astro';
import SideDock from '@/components/SideDock.astro';
import SettingsPanel from '@/components/SettingsPanel.svelte';
import { buildThemeCss } from '@/lib/theme-engine';
import { SITE, THEME_DEFAULTS } from '@/config/site';
import { DEFAULT_SETTINGS } from '@/lib/theme';

interface Props {
  title?: string;
  description?: string;
  /** 文章页传入，用于注入 JSON-LD BlogPosting */
  jsonLd?: Record<string, unknown>;
  /** 是否显示顶栏（登录页等可关掉） */
  showNav?: boolean;
  /** 文章页用窄栏居中，列表页用宽栏 */
  width?: 'wide' | 'reading';
}

const {
  title,
  description = SITE.description,
  jsonLd,
  showNav = true,
  width = 'wide',
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.subtitle}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;

// 构建期出厂配色：默认访客无需任何 JS 即得到正确颜色。
// 走与运行时同一个 buildThemeCss —— 两处若各算各的，访客改完色相就会丢令牌。
const defaultCss = buildThemeCss(THEME_DEFAULTS);

const ogImage = new URL('/og-default.svg', SITE.url).href;
---

<!doctype html>
<html lang={SITE.lang} data-theme-mode={DEFAULT_SETTINGS.mode} data-wallpaper={DEFAULT_SETTINGS.wallpaper} data-layout={DEFAULT_SETTINGS.layout} data-texture={DEFAULT_SETTINGS.texture}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#fef7ff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141218" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={SITE.lang.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 订阅源 -->
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href="/rss.xml" />
    <link rel="alternate" type="application/atom+xml" title={`${SITE.title} Atom`} href="/atom.xml" />

    <!--
      出厂配色：首屏直出，无需 JS。
      必须用 is:inline + set:html —— 普通 <style> 会被 Astro 的 CSS 管线抽成外部文件，
      那样既多一次请求，又会丢掉 id，导致下面的防闪烁脚本找不到它。
    -->
    <style id="jyuanblog-theme" is:inline set:html={defaultCss}></style>

    <!--
      品牌字体的 @font-face。文件名固定，实际字节由构建期的 scripts/build-fonts.mjs
      在 astro build **之后**按 dist 里真正出现的字符切出来（先引用、后填充）。
      必须 is:inline：普通 <style> 会进 Vite 的资源管线，而那一刻 /fonts/*.woff2
      还不存在，会被当成缺失资源报错。
      font-display: swap —— 子集只有几十 KB，但宁可闪一下系统字也不要标题空白。
    -->
    <style is:inline>
      @font-face {
        font-family: 'LXGW WenKai';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/lxgw-wenkai-subset.woff2') format('woff2');
      }
      @font-face {
        font-family: 'LXGW WenKai';
        font-style: normal;
        font-weight: 500 700;
        font-display: swap;
        src: url('/fonts/lxgw-wenkai-medium-subset.woff2') format('woff2');
      }
    </style>

    <!-- 防止配色闪烁：在任何渲染之前套用访客缓存 -->
    <script is:inline>
      (function () {
        var CSS_KEY = 'jyuanblog:theme-css';
        var S_KEY = 'jyuanblog:settings';
        var STYLE_ID = 'jyuanblog-theme';
        var root = document.documentElement;

        function inject(css) {
          var el = document.getElementById(STYLE_ID);
          if (!el) {
            el = document.createElement('style');
            el.id = STYLE_ID;
            document.head.appendChild(el);
          }
          el.textContent = css;
        }

        // 1) 访客改过配色 -> 用缓存的 CSS 覆盖出厂值
        try {
          var cached = localStorage.getItem(CSS_KEY);
          if (cached) inject(cached);
        } catch (e) {}

        // 2) 非色彩设置 -> data-* 属性与类
        var s = null;
        try {
          var raw = localStorage.getItem(S_KEY);
          if (raw) s = JSON.parse(raw);
        } catch (e) {}

        var mql = window.matchMedia('(prefers-color-scheme: dark)');
        /*
         * 明暗必须**无条件**算一次。
         * 早先整段包在 `if (s)` 里，于是没存过设置的新访客永远拿不到 .dark 类 ——
         * 而出厂默认档位是 'auto'（跟随系统），结果"默认跟随系统"形同虚设，
         * 系统暗色的访客整站看到亮色，且 CSS 不会报任何错。
         */
        var mode = (s && s.mode) || 'auto';
        var eff = mode === 'auto' ? (mql.matches ? 'dark' : 'light') : mode;
        root.classList.toggle('dark', eff === 'dark');
        if (mode === 'auto') {
          mql.addEventListener('change', function (e) {
            root.classList.toggle('dark', e.matches);
          });
        }

        if (s) {
          root.dataset.themeMode = s.mode || 'auto';
          root.dataset.wallpaper = s.wallpaper || 'banner';
          root.dataset.layout = s.layout || 'grid';
          root.dataset.texture = s.texture || 'none';
          if (typeof s.textureOpacity === 'number') {
            root.style.setProperty('--texture-opacity', String(s.textureOpacity));
          }
          if (s.reduceMotion) root.classList.add('motion-reduced');
        }
      })();
    </script>

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>

  <body class:list={['has-wallpaper', showNav && 'has-dock']}>
    <a href="#main" class="skip-link">跳到正文</a>
    {showNav && <TopAppBar />}

    <!--
      .shell 是「正文 + 常驻悬浮栏」的栅格容器。
      它自己带 .m3-layout，所以版心宽度、左右内边距与顶栏/页脚共用同一套规则：
      >= 1280px 时版心放宽到 1280，多出来的一格 64px 正好给图标条，
      主列因此**一点没被挤**（840 是不变量，反推见 variables.css）。
      窄屏时栅格只有一列，悬浮栏改成贴底的图标条。
    -->
    <div class="shell m3-layout">
      <main id="main" class={width === 'reading' ? 'narrow' : undefined}>
        <slot />
      </main>
      {showNav && <SideDock />}
    </div>

    <Footer />

    <!--
      设置面板用 client:idle 水合：岛本身很小，重的配色引擎由它按需动态 import。
      因此默认访客不会下载 HCT 引擎。
    -->
    {showNav && <SettingsPanel client:idle />}
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: var(--m3e-space-3) var(--m3e-space-5);
    background: var(--primary);
    color: var(--on-primary);
    border-radius: 0 0 var(--shape-corner-m) 0;
  }

  .skip-link:focus {
    left: 0;
  }

  .shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    /* 栅格间隙只在有悬浮栏那一格时才需要，写在宽屏档里 */
    column-gap: 0;
  }

  @media (min-width: 1280px) {
    .shell {
      grid-template-columns: minmax(0, 1fr) var(--dock-rail-w);
      column-gap: var(--m3e-space-6);
    }
  }

  main {
    min-width: 0;
    padding-top: var(--m3e-space-8);
    padding-bottom: var(--m3e-space-10);
    min-height: calc(100vh - var(--m3e-topbar-h) - 200px);
  }

  .narrow {
    max-width: var(--m3e-reading-max);
    margin-inline: auto;
  }

  /*
   * 窄屏档：悬浮栏收成贴底图标条，会给页面底部盖住一条。
   * 预留出它的高度，否则页脚最后一行永远被压住（滚动到底才发现）。
   */
  :global(body.has-dock) {
    padding-bottom: calc(var(--dock-bar-h) + var(--m3e-space-8));
  }

  @media (min-width: 1280px) {
    :global(body.has-dock) {
      padding-bottom: var(--m3e-space-6);
    }
  }
</style>
